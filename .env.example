OPENAI_API_KEY=your_openai_key_here
OPENAI_API_BASE=https://api.openai.com/v1
MISTRAL_KEY=your_mistral_key_here

# Hugging Face: required to download gated Llama 2 weights (models/llama.py → meta-llama/Llama-2-*-hf).
# Create a token at https://huggingface.co/settings/tokens and accept the model license on the model page.
HF_TOKEN=your_huggingface_token_here
# Optional alias; if unset, compose copies HF_TOKEN for libraries that read HUGGING_FACE_HUB_TOKEN only.
# HUGGING_FACE_HUB_TOKEN=
